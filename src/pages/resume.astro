---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Resume / CV"
  description="Resume and CV of Dinuli Galgamuwa — Engineering Undergraduate, CIMA Candidate, and Consulting & Strategy Aspirant."
  activeNav="resume"
>
  <!-- Page Header -->
  <div class="page-header">
    <div class="container">
      <div class="page-header__flex">
        <div>
          <span class="section__eyebrow reveal">Curriculum Vitae</span>
          <h1 class="page-header__title reveal reveal--delay-1">Resume</h1>
        </div>
        <div class="reveal reveal--delay-2">
          <!-- TODO: Add the real resume PDF to /public/resume.pdf before deploying -->
          <a href="/resume.pdf" class="btn btn--gold" id="resume-download-btn" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download PDF
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="resume-wrapper">
    <div class="container">
      <div class="resume-layout">

        <!-- ── SIDEBAR ──────────────────────────────────────── -->
        <aside class="resume-sidebar">
          <!-- Contact -->
          <div class="sidebar-card reveal">
            <div class="sidebar-card__avatar">
              <!-- TODO: Replace with Dinuli's real photo -->
              <img src="/images/avatar-placeholder.png" alt="Dinuli Galgamuwa" />
            </div>
            <div class="sidebar-card__name">Dinuli Galgamuwa</div>
            <div class="sidebar-card__title">Engineering Undergraduate · CIMA Student</div>

            <div class="contact-list">
              <div class="contact-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 6.81a19.79 19.79 0 0 1-3-8.57A2 2 0 0 1 3.11 0h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 7.91a16 16 0 0 0 6.18 6.18l1.27-.84a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                +94 71 014 6512
              </div>
              <div class="contact-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                dinulisengalgamuwa<wbr />@gmail.com
              </div>
              <div class="contact-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Anuradhapura, Sri Lanka
              </div>
              <a class="contact-item contact-item--link" href="https://linkedin.com/in/dinuligalgamuwa" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                linkedin.com/in/dinuligalgamuwa
              </a>
            </div>
          </div>

          <!-- Core Technical Skills -->
          <div class="sidebar-section reveal reveal--delay-1">
            <h3 class="sidebar-section__title">Core Technical Skills</h3>
            <ul class="sidebar-list">
              <li>Advanced Microsoft Excel</li>
              <li>Python, C#, R</li>
              <li>Data Analysis &amp; Reporting</li>
              <li>Advanced Operations Research</li>
              <li>Quantitative Methods</li>
              <li>Cost &amp; Budget Analysis</li>
              <li>Financial Analysis</li>
            </ul>
          </div>

          <!-- Languages -->
          <div class="sidebar-section reveal reveal--delay-2">
            <h3 class="sidebar-section__title">Languages</h3>
            <div class="lang-item">
              <span>English</span>
              <div class="lang-bar"><div class="lang-bar__fill" style="width: 90%;"></div></div>
            </div>
            <div class="lang-item">
              <span>Sinhala</span>
              <div class="lang-bar"><div class="lang-bar__fill" style="width: 100%;"></div></div>
            </div>
          </div>
        </aside>

        <!-- ── MAIN CONTENT ─────────────────────────────────── -->
        <main class="resume-main">

          <!-- Summary -->
          <section class="resume-section reveal" aria-labelledby="summary-heading">
            <h2 class="resume-section__title" id="summary-heading">
              <span class="resume-section__icon">◈</span> Professional Summary
            </h2>
            <p class="resume-summary">
              Engineering undergraduate specialising in Transport Management &amp; Logistics Engineering at
              the University of Moratuwa (Dean's List, 4.0 GPA). Blends technical logistics expertise with
              advanced management accounting frameworks (CIMA Management Level — Completed). Proven ability
              to leverage data-driven problem-solving and financial modelling to optimise operations.
              Eager to bring a hybrid technical and strategic skillset to a management consulting internship
              starting in November 2026.
            </p>
          </section>

          <!-- Education -->
          <section class="resume-section reveal" aria-labelledby="edu-heading-resume">
            <h2 class="resume-section__title" id="edu-heading-resume">
              <span class="resume-section__icon">◈</span> Higher Education
            </h2>

            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-date">2024 – Present</div>
                <div class="timeline-title">University of Moratuwa</div>
                <div class="timeline-subtitle">BSc Engineering (Hons) in Transport Management &amp; Logistics Engineering</div>
                <div class="timeline-body">
                  3rd Year Undergraduate · Semester 04 · <strong>Dean's List (4.0 GPA)</strong>
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-date">Prior to 2024</div>
                <div class="timeline-title">Central College Anuradhapura</div>
                <div class="timeline-subtitle">GCE Advanced Level — Physical Science Stream</div>
                <div class="timeline-body">
                  Chemistry A · Physics B · Combined Mathematics C<br />
                  GCE Ordinary Level — 9 A Passes
                </div>
              </div>
            </div>
          </section>

          <!-- Professional Qualifications -->
          <section class="resume-section reveal" aria-labelledby="qual-heading">
            <h2 class="resume-section__title" id="qual-heading">
              <span class="resume-section__icon">◈</span> Professional Qualifications
            </h2>

            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-date">2025 – Present</div>
                <div class="timeline-title">Chartered Institute of Management Accountants (CIMA – UK)</div>
                <div class="timeline-subtitle">Management Accounting Professional Qualification</div>
                <div class="timeline-body">
                  Management Level — <strong>Completed</strong><br />
                  Strategic Level — Expected Completion <strong>August 2026</strong>
                </div>
              </div>
            </div>
          </section>

          <!-- Additional Qualifications -->
          <section class="resume-section reveal" aria-labelledby="addqual-heading">
            <h2 class="resume-section__title" id="addqual-heading">
              <span class="resume-section__icon">◈</span> Additional Qualifications &amp; Certifications
            </h2>

            <div class="cert-table">
              <div class="cert-row">
                <div class="cert-row__name">
                  <strong>McKinsey Forward Programme</strong>
                  <span class="badge badge--completed">✓ Completed</span>
                </div>
                <div class="cert-row__date">June 2026</div>
                <div class="cert-row__desc">Digital Badge Achieved — problem-solving, personal effectiveness, and consulting toolkit.</div>
              </div>

              <div class="cert-row">
                <div class="cert-row__name">
                  <strong>NVIDIA Fundamentals of Accelerated Data Science</strong>
                  <span class="badge badge--completed">✓ Completed</span>
                </div>
                <div class="cert-row__date">2025</div>
                <div class="cert-row__desc">GPU-accelerated data science with RAPIDS — Certificate Course.</div>
              </div>

              <div class="cert-row">
                <div class="cert-row__name">
                  <strong>Cambridge English KET &amp; PET</strong>
                  <span class="badge badge--completed">✓ Completed</span>
                </div>
                <div class="cert-row__date">–</div>
                <div class="cert-row__desc">British Council verified English language proficiency.</div>
              </div>

              <div class="cert-row">
                <div class="cert-row__name">
                  <strong>Microsoft Power BI Data Analyst</strong>
                  <span class="badge badge--ongoing">● In Progress</span>
                </div>
                <div class="cert-row__date">Expected Nov 2026</div>
                <div class="cert-row__desc">Professional certificate covering data modelling, DAX, and reporting.</div>
              </div>

              <div class="cert-row">
                <div class="cert-row__name">
                  <strong>SAP Technology Consultant Professional Certificate</strong>
                  <span class="badge badge--ongoing">● In Progress</span>
                </div>
                <div class="cert-row__date">Expected Jan 2027</div>
                <div class="cert-row__desc">ERP systems, SAP implementation fundamentals, enterprise consulting.</div>
              </div>
            </div>
          </section>

          <!-- Projects -->
          <section class="resume-section reveal" aria-labelledby="projects-heading">
            <h2 class="resume-section__title" id="projects-heading">
              <span class="resume-section__icon">◈</span> Projects
            </h2>

            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-date">2026</div>
                <div class="timeline-title">Pharmacy Inventory Monitoring &amp; Optimisation System</div>
                <div class="timeline-body">
                  Built a real-time tracking system with automated purchasing and return alerts to prevent
                  stockouts and optimise inventory flow. Reduced emergency procurement events by ~40% and
                  expiry write-offs by ~35% within three months.
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-date">2026 — Ongoing</div>
                <div class="timeline-title">Empty Container Optimisation Model</div>
                <div class="timeline-body">
                  Developing a minimum-cost flow optimisation model for container repositioning across a
                  logistics network, minimising transport costs and maximising asset utilisation.
                  Extending to stochastic programming to handle demand uncertainty.
                </div>
              </div>
            </div>
          </section>

          <!-- Leadership & Extracurricular -->
          <section class="resume-section reveal" aria-labelledby="leadership-heading">
            <h2 class="resume-section__title" id="leadership-heading">
              <span class="resume-section__icon">◈</span> Leadership &amp; Extracurricular
            </h2>

            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-date">2025 – 2026</div>
                <div class="timeline-title">Rotaract Club — University of Moratuwa</div>
                <div class="timeline-subtitle">Lead, Partnerships Committee</div>
                <div class="timeline-body">
                  Inducted 2025. Leading partnership development for community engagement initiatives.
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-date">2024 – Present</div>
                <div class="timeline-title">Society of Transport &amp; Logistics</div>
                <div class="timeline-subtitle">Member — University of Moratuwa</div>
              </div>

              <div class="timeline-item">
                <div class="timeline-date">2024 – Present</div>
                <div class="timeline-title">Classical Music Society</div>
                <div class="timeline-subtitle">Member — University of Moratuwa</div>
              </div>
            </div>
          </section>

          <!-- References -->
          <section class="resume-section reveal" aria-labelledby="refs-heading">
            <h2 class="resume-section__title" id="refs-heading">
              <span class="resume-section__icon">◈</span> References
            </h2>

            <div class="refs-grid">
              <div class="ref-card">
                <div class="ref-card__name">Niles Perera</div>
                <div class="ref-card__role">Professor &amp; Head of Department</div>
                <div class="ref-card__org">Department of Transport Management &amp; Logistics Engineering, University of Moratuwa, Sri Lanka</div>
                <div class="ref-card__contact">
                  <span>📞 +94770403788</span>
                  <a href="mailto:hniles@uom.lk">hniles@uom.lk</a>
                </div>
              </div>

              <div class="ref-card">
                <div class="ref-card__name">Akila Gunarathna</div>
                <div class="ref-card__role">Director — Corporate Finance, Cinnamon Hotels &amp; Resorts</div>
                <div class="ref-card__org">Chairman of Inspire Business School</div>
                <div class="ref-card__contact">
                  <span>📞 +94 778 371 001</span>
                  <a href="mailto:isigera@uom.lk">isigera@uom.lk</a>
                </div>
              </div>
            </div>
          </section>

        </main>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: calc(var(--nav-height) + var(--space-10));
    padding-bottom: var(--space-10);
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header__flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .page-header__title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  /* Resume layout */
  .resume-wrapper {
    padding-block: var(--space-16);
  }

  .resume-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  /* Sidebar */
  .resume-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-6));
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-card {
    background: var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    color: #fff;
    text-align: center;
  }

  .sidebar-card__avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    overflow: hidden;
    margin-inline: auto;
    margin-bottom: var(--space-4);
    border: 3px solid rgba(255,255,255,0.3);
  }

  .sidebar-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-card__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: var(--space-1);
  }

  .sidebar-card__title {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: var(--space-5);
    line-height: 1.5;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-align: left;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.78rem;
    color: rgba(255,255,255,0.85);
    word-break: break-all;
  }

  .contact-item svg { flex-shrink: 0; margin-top: 2px; }

  .contact-item--link {
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact-item--link:hover { color: var(--color-secondary-light); }

  .sidebar-section {
    background: #fff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .sidebar-section__title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-primary-light);
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-list li {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .sidebar-list li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    flex-shrink: 0;
  }

  /* Language bars */
  .lang-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .lang-item span { min-width: 70px; }

  .lang-bar {
    flex: 1;
    height: 6px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .lang-bar__fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
    border-radius: var(--radius-full);
  }

  /* Resume main sections */
  .resume-section {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .resume-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .resume-section__title {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .resume-section__icon {
    color: var(--color-secondary);
  }

  .resume-summary {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 0;
  }

  /* Cert table */
  .cert-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cert-row {
    display: grid;
    grid-template-columns: 1fr 100px;
    grid-template-rows: auto auto;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4);
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .cert-row__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: 0.9rem;
  }

  .cert-row__date {
    font-size: 0.78rem;
    color: var(--color-secondary);
    font-weight: 600;
    text-align: right;
    align-self: center;
  }

  .cert-row__desc {
    grid-column: 1 / -1;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  /* References */
  .refs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .ref-card {
    padding: var(--space-5);
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .ref-card__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .ref-card__role {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-1);
  }

  .ref-card__org {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .ref-card__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .ref-card__contact a {
    color: var(--color-primary-dark);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .resume-layout {
      grid-template-columns: 240px 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .resume-layout { grid-template-columns: 1fr; }
    .resume-sidebar { position: static; }
    .refs-grid { grid-template-columns: 1fr; }
    .cert-row { grid-template-columns: 1fr; }
    .cert-row__date { text-align: left; }
    .page-header__flex { flex-direction: column; align-items: flex-start; }
  }

  @media print {
    .resume-sidebar { position: static; }
    .resume-layout { grid-template-columns: 200px 1fr; gap: 1rem; }
  }
</style>
