---
import BaseLayout from './BaseLayout.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, heroImage } = post.data;

// Estimated reading time
const wordsPerMinute = 200;
const wordCount = (post.body ?? '').split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / wordsPerMinute));

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<BaseLayout title={title} description={description} activeNav="blog">
  <article class="blog-post">
    <!-- Hero Banner -->
    <div class="blog-post__hero">
      {heroImage && (
        <img
          src={heroImage}
          alt={title}
          class="blog-post__hero-img"
          loading="eager"
        />
      )}
    </div>

    <div class="container">
      <div class="blog-post__header">
        <a href="/blog" class="blog-post__back">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          All Posts
        </a>

        <div class="blog-post__meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span>·</span>
          <span>{readingTime} min read</span>
        </div>

        <h1 class="blog-post__title">{title}</h1>

        {description && (
          <p class="blog-post__description">{description}</p>
        )}

        {tags && tags.length > 0 && (
          <div class="tags">
            {tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>

      <div class="prose">
        <slot />
      </div>

      <div class="blog-post__footer">
        <a href="/blog" class="btn btn--secondary btn--sm">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Blog
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    padding-top: var(--nav-height);
    padding-bottom: var(--space-20);
  }

  .blog-post__hero {
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-bg-alt) 100%);
    height: 260px;
    overflow: hidden;
    margin-bottom: var(--space-10);
  }

  .blog-post__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }

  .blog-post__header {
    max-width: 70ch;
    margin-inline: auto;
    margin-bottom: var(--space-10);
    padding-top: var(--space-4);
  }

  .blog-post__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }

  .blog-post__back:hover { color: var(--color-primary); }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.8rem;
    color: var(--color-secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .blog-post__title {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    margin-bottom: var(--space-4);
  }

  .blog-post__description {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .blog-post__footer {
    max-width: 70ch;
    margin-inline: auto;
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
</style>
